<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <ASPNETCORE_ENVIRONMENT>Testing</ASPNETCORE_ENVIRONMENT>
      <Persistence__Mode>InMemory</Persistence__Mode>
      <Database__Host></Database__Host>
      <Database__Username></Database__Username>
      <Database__Password></Database__Password>
      <ApplicationIdentity__DefaultActorUserId>1</ApplicationIdentity__DefaultActorUserId>
      <TemplateProcessing__EnableAutomaticDecimalRecognition>true</TemplateProcessing__EnableAutomaticDecimalRecognition>
      <TemplateProcessing__EnableAutomaticIntegerRecognition>true</TemplateProcessing__EnableAutomaticIntegerRecognition>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
